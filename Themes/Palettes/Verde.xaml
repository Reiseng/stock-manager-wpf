<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta "Verde". Todos los temas definen exactamente las mismas claves. -->
    <Color x:Key="C.Bg">#EEF2F0</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.SurfaceAlt">#F5F8F6</Color>
    <Color x:Key="C.Line">#D8E0DC</Color>
    <Color x:Key="C.LineStrong">#B9C6C0</Color>
    <Color x:Key="C.Ink">#1B2421</Color>
    <Color x:Key="C.Muted">#5E6B66</Color>
    <Color x:Key="C.Primary">#2F6B57</Color>
    <Color x:Key="C.PrimaryHover">#265948</Color>
    <Color x:Key="C.PrimarySoft">#DDEBE5</Color>
    <Color x:Key="C.OnPrimary">#FFFFFF</Color>
    <Color x:Key="C.Sidebar">#1F3A33</Color>
    <Color x:Key="C.SidebarHover">#2B4C43</Color>
    <Color x:Key="C.SidebarActive">#365C52</Color>
    <Color x:Key="C.SidebarText">#C7D7D0</Color>
    <Color x:Key="C.Accent">#E0A526</Color>
    <Color x:Key="C.AccentHover">#CC951F</Color>
    <Color x:Key="C.AccentInk">#2A2105</Color>
    <Color x:Key="C.Danger">#B6463A</Color>
    <Color x:Key="C.DangerSoft">#F6E3E0</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}"/>
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource C.LineStrong}"/>
    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource C.Ink}"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource C.Muted}"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource C.Primary}"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource C.PrimaryHover}"/>
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="{StaticResource C.PrimarySoft}"/>
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="{StaticResource C.OnPrimary}"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource C.Sidebar}"/>
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="{StaticResource C.SidebarHover}"/>
    <SolidColorBrush x:Key="Brush.SidebarActive" Color="{StaticResource C.SidebarActive}"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="{StaticResource C.SidebarText}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource C.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentInk" Color="{StaticResource C.AccentInk}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource C.DangerSoft}"/>
</ResourceDictionary>
