<UserControl x:Class="StockControl.Views.Products.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StockControl.Utils"
             Background="{DynamicResource Brush.Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Productos" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0">
                <Run Text="{Binding Products.Count, Mode=OneWay}"/>
                <Run Text="productos"/>
            </TextBlock>
        </StackPanel>

        <!-- Search + actions -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}" Tag="Buscar por nombre o código"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Loaded="SearchBox_Loaded"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Danger}" Tag="&#xE74D;" Content="Eliminar" ContentTemplate="{StaticResource IconText}"
                        Command="{Binding DeleteCommand}" Margin="10,0,0,0"
                        Visibility="{Binding ViewMode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=Editable}"/>
                <Button Tag="&#xE70F;" Content="Editar" ContentTemplate="{StaticResource IconText}"
                        Command="{Binding EditCommand}" Margin="10,0,0,0"
                        Visibility="{Binding ViewMode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=Editable}"/>
                <Button Style="{StaticResource Button.Primary}" Tag="&#xE710;" Content="Agregar producto" ContentTemplate="{StaticResource IconText}"
                        Command="{Binding AddCommand}" Margin="10,0,0,0"/>
                <Button Style="{StaticResource Button.Primary}" Tag="&#xE73E;" Content="Seleccionar" ContentTemplate="{StaticResource IconText}"
                        Command="{Binding ConfirmCommand}" Margin="10,0,0,0"
                        Visibility="{Binding ViewMode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=SelectOnly}" IsDefault="True"/>
            </StackPanel>
        </Grid>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource GridPanel}">
            <Grid>
                <DataGrid ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Barcode}" Width="140" ElementStyle="{StaticResource Cell.Muted}"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Marca" Binding="{Binding Brand}" Width="*"/>
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unit, Converter={StaticResource EnumDescriptionConverter}}" Width="110"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat={}{0:0.###}}" Width="90" ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Header.Right}"/>
                        <DataGridTextColumn Header="IVA" Binding="{Binding Tax, StringFormat={}{0:0.##}%}" Width="70" ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Header.Right}"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat={}{0:C2}}" Width="120" ElementStyle="{StaticResource Cell.Strong}" HeaderStyle="{StaticResource Header.Right}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Todavía no hay productos. Usá «Agregar producto» para cargar el primero." Style="{StaticResource Subtle}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360" IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Products.Count">
                            <Binding.Converter><x:Static Member="local:ZeroToVisibleConverter.Instance"/></Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
