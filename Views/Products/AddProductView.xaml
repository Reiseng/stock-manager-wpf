<UserControl x:Class="StockControl.Views.Products.AddProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="520" Margin="32,28,32,24">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="24"/>
        <TextBlock Text="Los campos con * son obligatorios. El precio se carga sin IVA." Style="{StaticResource Subtle}" Margin="0,4,0,8"/>
        <StackPanel>
            <TextBlock Text="Código de barras *" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Tag="Escaneá o escribí el código"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Nombre *" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: Yerba mate 1 kg"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Marca" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: Playadito"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Precio sin IVA *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="IVA (%)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tax, UpdateSourceTrigger=PropertyChanged}" Tag="21"/>
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Stock" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Se vende por" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding UnitTypes}" SelectedItem="{Binding SelectedUnitType}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>
        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Content="Guardar" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"
                    IsDefault="True" Margin="10,0,0,0" MinWidth="120"/>
        </StackPanel>
    </StackPanel>
</UserControl>
