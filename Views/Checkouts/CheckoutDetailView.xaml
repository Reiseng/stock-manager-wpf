<UserControl x:Class="StockControl.Views.Checkouts.CheckoutDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28" Width="820">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" FontSize="24">
                <Run Text="Comprobante N°"/>
                <Run Text="{Binding ID, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding Date, StringFormat={}{0:dddd dd/MM/yyyy, HH:mm}}" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ARCA status -->
        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                CornerRadius="6" Padding="12,6" Background="{DynamicResource Brush.PrimarySoft}">
            <StackPanel>
                <TextBlock Text="{Binding FiscalSummary}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding FiscalDetail}" Style="{StaticResource Subtle}" FontSize="12" MaxWidth="320"/>
            </StackPanel>
        </Border>

        <!-- Client -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="16,12" Margin="0,18,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ClientFullName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Run Text="DNI/CUIL"/>
                    <Run Text="{Binding ClientDocument, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Items -->
        <Border Grid.Row="2" Style="{StaticResource GridPanel}" MaxHeight="380">
            <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="90"
                                        ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Header.Right}"/>
                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unit, Converter={StaticResource EnumDescriptionConverter}}" Width="100"
                                        ElementStyle="{StaticResource Cell.Muted}"/>
                    <DataGridTextColumn Header="Precio s/IVA" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="120"
                                        ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Header.Right}"/>
                    <DataGridTextColumn Header="IVA" Binding="{Binding Tax, StringFormat={}{0:0.##}%}" Width="70"
                                        ElementStyle="{StaticResource Cell.Right}" HeaderStyle="{StaticResource Header.Right}"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="130"
                                        ElementStyle="{StaticResource Cell.Strong}" HeaderStyle="{StaticResource Header.Right}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Total + PDF -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Total con IVA" Style="{StaticResource Subtle}"/>
                <TextBlock Text="{Binding Total, StringFormat={}{0:C2}}" Style="{StaticResource Figure}"/>
            </StackPanel>
            <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Tag="&#xE749;" Content="Generar PDF" ContentTemplate="{StaticResource IconText}"
                    Command="{Binding PrintPDFCommand}"/>
        </Grid>
    </Grid>
</UserControl>
