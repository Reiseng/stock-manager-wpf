<UserControl x:Class="StockControl.Views.Checkouts.CheckoutHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StockControl.Utils"
             Background="{DynamicResource Brush.Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Historial de ventas" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0">
                <Run Text="{Binding Checkouts.Count, Mode=OneWay}"/>
                <Run Text="comprobantes"/>
            </TextBlock>
        </StackPanel>

        <!-- Search + actions -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}" Tag="Buscar por número, cliente o factura"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Loaded="SearchBox_Loaded"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Tag="&#xE8D4;" Content="Facturar en ARCA" ContentTemplate="{StaticResource IconText}"
                        Command="{Binding SendToArcaCommand}" Margin="10,0,0,0"
                        ToolTip="Pide el CAE para una venta interna, pendiente o rechazada"
                        Visibility="{Binding ArcaEnabled, Converter={StaticResource BoolToVisibility}}"/>
                <Button Style="{StaticResource Button.Primary}" Tag="&#xE8A5;" Content="Ver detalle" ContentTemplate="{StaticResource IconText}"
                        Command="{Binding DetailCommand}" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource GridPanel}">
            <Grid>
                <DataGrid ItemsSource="{Binding Checkouts}"
                          SelectedItem="{Binding SelectedCheckout, Mode=TwoWay}"
                          IsReadOnly="True">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DetailCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding ID}" Width="80" ElementStyle="{StaticResource Cell.Muted}"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                        <DataGridTextColumn Header="Operación" Binding="{Binding operationType, Converter={StaticResource EnumDescriptionConverter}}" Width="*"/>
                        <DataGridTextColumn Header="ARCA" Binding="{Binding FiscalSummary}" Width="1.6*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding FiscalMessage}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FiscalStatus}" Value="Internal">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FiscalStatus}" Value="Pending">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FiscalStatus}" Value="Rejected">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Client}" Width="1.5*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="140" ElementStyle="{StaticResource Cell.Strong}" HeaderStyle="{StaticResource Header.Right}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Todavía no hay ventas registradas." Style="{StaticResource Subtle}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360" IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Checkouts.Count">
                            <Binding.Converter><x:Static Member="local:ZeroToVisibleConverter.Instance"/></Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
