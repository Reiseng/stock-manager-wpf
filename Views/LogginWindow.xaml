<Window x:Class="StockControl.Views.LogginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StockControl.ViewModels"
        xmlns:services="clr-namespace:StockControl.Services"
        Style="{StaticResource AppWindow}"
        Title="Stock Manager"
        Width="860" Height="520"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:LogginWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand -->
        <Border Background="{DynamicResource Brush.Sidebar}">
            <Grid Margin="40,44,40,32">
                <StackPanel>
                    <TextBlock Text="Stock&#x0a;Manager" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold"
                               FontSize="44" LineHeight="46" LineStackingStrategy="BlockLineHeight" Foreground="White"/>
                    <Border Height="4" Width="44" Background="{DynamicResource Brush.Accent}"
                            HorizontalAlignment="Left" Margin="0,20,0,20" CornerRadius="2"/>
                    <TextBlock Text="Stock, ventas y clientes de tu negocio, en una sola caja."
                               Foreground="{DynamicResource Brush.SidebarText}" FontSize="15" TextWrapping="Wrap"
                               LineHeight="22"/>
                </StackPanel>
                <TextBlock Text="{x:Static services:UpdateService.CurrentVersionText}" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource Brush.SidebarText}" FontSize="12" Opacity="0.7"/>
            </Grid>
        </Border>

        <!-- Form -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}">
            <StackPanel Width="340" VerticalAlignment="Center">
                <TextBlock Text="Iniciar sesión" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Ingresá con tu usuario y contraseña." Style="{StaticResource Subtle}" Margin="0,4,0,10"/>

                <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Loaded="UsernameBox_Loaded"/>

                <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}"/>
                <PasswordBox PasswordChanged="PasswordBox_PasswordChanged"/>

                <CheckBox Content="Mantener sesión iniciada en esta PC"
                          IsChecked="{Binding RememberMe}" Margin="0,16,0,0"
                          ToolTip="Al abrir el programa se entra directo, sin contraseña. Se olvida al cerrar sesión."/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}, ConverterParameter=Inverse}"/>

                <Button Content="Ingresar" Style="{StaticResource Button.Primary}" IsDefault="True"
                        Command="{Binding LogginCommand}" Margin="0,22,0,0" MinHeight="44" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
