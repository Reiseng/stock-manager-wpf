<UserControl x:Class="StockControl.Views.Settings.SettingsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Configuración" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Datos del negocio, apariencia y copias de seguridad." Style="{StaticResource Subtle}" Margin="0,4,0,20"/>

            <!-- Business data -->
            <Border Style="{StaticResource Panel}" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Datos del negocio" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Se imprimen en los comprobantes." Style="{StaticResource Subtle}" Margin="0,4,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Nombre *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="CUIT *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CUIT, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: 20-12345678-9"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Condición frente al IVA *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding TaxConditions}" SelectedItem="{Binding SelectedTaxCondition}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Guardar cambios" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right"
                            Margin="0,24,0,0" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Panel}" Padding="28,24" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Apariencia" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Se aplica al instante y queda guardado en esta PC."
                               Style="{StaticResource Subtle}" Margin="0,4,0,16"/>
                    <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,14,14"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Width="176" CornerRadius="10" Padding="10"
                                                    Background="{DynamicResource Brush.Surface}"
                                                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Miniature: sidebar + page with a primary bar and the accent -->
                                    <Border CornerRadius="6" Height="78" ClipToBounds="True" Background="{Binding PreviewBackground}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding PreviewSidebar}" CornerRadius="6,0,0,6"/>
                                            <StackPanel Grid.Column="1" Margin="10,12,10,0">
                                                <Border Height="8" Width="56" CornerRadius="2" HorizontalAlignment="Left"
                                                        Background="{Binding PreviewSidebar}" Opacity="0.55"/>
                                                <Border Height="12" Width="44" CornerRadius="3" HorizontalAlignment="Left"
                                                        Background="{Binding PreviewPrimary}" Margin="0,12,0,0"/>
                                                <Border Height="14" CornerRadius="3" Background="{Binding PreviewAccent}" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,10,0,0"
                                               Foreground="{DynamicResource Brush.Ink}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" FontSize="12"
                                               Margin="2,2,0,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Backups -->
            <Border Style="{StaticResource Panel}" Padding="28,24" Margin="0,20,0,24">
                <StackPanel>
                    <TextBlock Text="Copias de seguridad" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0"
                               Text="Exportá una copia para guardarla en un pendrive o en la nube. Importar reemplaza todos los datos actuales por los de la copia (antes se guarda una copia de lo que había)."/>

                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14"
                                           Foreground="{DynamicResource Brush.Primary}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding LastBackupText}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Subtle}" Margin="24,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <Run Text="{Binding SchemaVersionText, Mode=OneWay}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding DatabasePath, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,18,0,0">
                        <Button Style="{StaticResource Button.Primary}" Tag="&#xE896;" Content="Exportar copia..."
                                ContentTemplate="{StaticResource IconText}" Command="{Binding ExportDatabaseCommand}" Margin="0,0,10,0"/>
                        <Button Tag="&#xE898;" Content="Importar copia..." ContentTemplate="{StaticResource IconText}"
                                Command="{Binding ImportDatabaseCommand}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource Button.Ghost}" Tag="&#xE838;" Content="Abrir carpeta de copias"
                                ContentTemplate="{StaticResource IconText}" Command="{Binding OpenBackupFolderCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
