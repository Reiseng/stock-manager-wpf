<Window x:Class="StockControl.Views.Windows.PrintActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.LineStrong}"
            BorderThickness="1" CornerRadius="12" Padding="30,26" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel Width="380">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.PrimarySoft}">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Primary}"
                               HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Operación registrada" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock Text="¿Querés generar el comprobante en PDF para imprimirlo o enviarlo?"
                       Style="{StaticResource Subtle}" FontSize="14" Margin="0,14,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="No, seguir vendiendo" Command="{Binding ConfirmCheckoutCommand}" IsCancel="True"/>
                <Button Style="{StaticResource Button.Primary}" Tag="&#xE749;" Content="Generar PDF"
                        ContentTemplate="{StaticResource IconText}" Command="{Binding GenerateInvoicePDFCommand}"
                        IsDefault="True" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
