<Window x:Class="StockControl.Views.Windows.PrintActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.LineStrong}"
            BorderThickness="1" CornerRadius="12" Padding="30,26" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel Width="400">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE73E;"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="330"/>
            </StackPanel>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="14" Margin="0,14,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Seguir vendiendo" Command="{Binding ConfirmCheckoutCommand}" IsCancel="True"/>
                <Button Tag="&#xE8A5;" Content="PDF (A4)"
                        ContentTemplate="{StaticResource IconText}" Command="{Binding GenerateInvoicePDFCommand}"
                        IsDefault="{Binding PdfIsDefault, Mode=OneWay}" Margin="10,0,0,0"/>
                <Button Style="{StaticResource Button.Primary}" Tag="&#xE749;" Content="Imprimir ticket"
                        ContentTemplate="{StaticResource IconText}" Command="{Binding PrintTicketCommand}"
                        IsDefault="{Binding HasTicketPrinter, Mode=OneWay}" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
