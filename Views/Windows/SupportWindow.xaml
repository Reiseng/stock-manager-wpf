<Window x:Class="StockControl.Views.Windows.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:StockControl.Services"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Brush.Surface}"
        Title="Soporte"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Width="440" Margin="32,28,32,26">
        <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource Brush.PrimarySoft}">
                <TextBlock Text="&#xE897;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Primary}"
                           HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Soporte" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{x:Static services:SupportInfo.Name}" Style="{StaticResource Subtle}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{x:Static services:SupportInfo.Message}" TextWrapping="Wrap" LineHeight="21" Margin="0,18,0,0"/>

        <!-- Contact -->
        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="16,12" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="WhatsApp" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,18,6"/>
                <TextBlock Grid.Column="1" Text="{x:Static services:SupportInfo.WhatsAppDisplay}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="Email" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,18,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static services:SupportInfo.Email}" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- What to send when asking for help -->
        <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap">
            <Run Text="Si escribís por un problema, contá qué estabas haciendo y mencioná la versión"/>
            <Run Text="{x:Static services:UpdateService.CurrentVersionText}" FontWeight="SemiBold"/><Run Text="."/>
        </TextBlock>

        <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource Button.Ghost}" Content="Copiar datos" Click="Copy_Click" Margin="0,0,8,0"/>
            <Button Content="Enviar email" Click="Email_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Button.Primary}" Tag="&#xE8BD;" Content="Escribir por WhatsApp"
                    ContentTemplate="{StaticResource IconText}" Click="WhatsApp_Click" IsDefault="True"/>
        </WrapPanel>
    </StackPanel>
</Window>
