<Window x:Class="StockControl.Views.Windows.FirstAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Brush.Surface}"
        Title="Crear administrador"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <StackPanel Width="420" Margin="32,28,32,26">
        <TextBlock Text="Creá el usuario administrador" Style="{StaticResource SectionTitle}"/>
        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                   Text="Es el usuario que puede configurar el programa y crear a los demás (cajeros, repositores). Guardá bien la contraseña: no se puede recuperar."/>

        <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="UsernameInput" Text="Admin"/>

        <TextBlock Text="Contraseña (mínimo 8 caracteres)" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="PasswordInput"/>

        <TextBlock Text="Repetir contraseña" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="RepeatInput"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
                   Margin="0,14,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Salir" IsCancel="True" Margin="0,0,10,0"/>
            <Button Style="{StaticResource Button.Primary}" Content="Crear y entrar" IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
