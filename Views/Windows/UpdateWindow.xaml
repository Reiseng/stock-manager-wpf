<Window x:Class="StockControl.Views.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource Brush.Surface}"
        Title="Actualización disponible"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <StackPanel Width="460" Margin="32,28,32,26">
        <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource Brush.PrimarySoft}">
                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Primary}"
                           HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Hay una versión nueva" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource Subtle}">
                    <Run Text="{Binding NewVersionText, Mode=OneWay}"/>
                    <Run Text="·"/>
                    <Run Text="{Binding CurrentVersionText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- What's new (release notes from GitHub) -->
        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="16,12" Margin="0,18,0,0"
                MaxHeight="180"
                Visibility="{Binding ReleaseNotes, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}, ConverterParameter=Inverse}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" FontSize="13"/>
            </ScrollViewer>
        </Border>

        <TextBlock Style="{StaticResource Subtle}" Margin="0,16,0,0"
                   Text="Tus datos no se tocan: antes de actualizar la base de datos se guarda una copia automática."/>

        <!-- Progress -->
        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Value="{Binding Progress}" Maximum="100"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding Status, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}, ConverterParameter=Inverse}"/>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource Button.Ghost}" Content="Más tarde" Command="{Binding LaterCommand}"/>
            <Button Content="Al cerrar el programa" Command="{Binding UpdateOnExitCommand}" Margin="8,0,0,0"
                    ToolTip="Se descarga ahora y se instala cuando cierres el programa"/>
            <Button Style="{StaticResource Button.Primary}" Content="Actualizar ahora" Command="{Binding UpdateNowCommand}"
                    Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
