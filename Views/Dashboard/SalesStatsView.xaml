<UserControl x:Class="StockControl.Views.Dashboard.SalesStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- Range picker: segmented buttons -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small label above a figure -->
        <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource Subtle}"/>
        <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- A vertical bar: the space is split between Rest (empty, on top) and Fill (the bar) -->
        <DataTemplate x:Key="VerticalBar">
            <Grid x:Name="Root" ToolTip="{Binding Tooltip}" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Rest}"/>
                    <RowDefinition Height="{Binding Fill}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="Bar" Grid.Row="1" Margin="3,0" CornerRadius="3,3,0,0" Background="{DynamicResource Brush.Primary}" Opacity="0.85"/>
                <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="None"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPeak}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="BarRow">
            <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>

        <!-- Empty state over a chart -->
        <Style x:Key="EmptyHint" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasData}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Main panel: range, figures and timeline -->
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ventas" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Subtle}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Brush.SurfaceAlt}"
                            CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="StatsRange" Content="7 días" IsChecked="{Binding Is7Days}"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="StatsRange" Content="30 días" IsChecked="{Binding Is30Days}"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="StatsRange" Content="12 semanas" IsChecked="{Binding Is12Weeks}"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="StatsRange" Content="12 meses" IsChecked="{Binding Is12Months}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Brush.Danger}" Margin="0,12,0,0"
                           Visibility="{Binding ErrorText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>

                <!-- Figures -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Vendido" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding NetText}" Style="{StaticResource KpiValue}"/>
                        <TextBlock Text="{Binding ChangeText}" FontSize="12" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChangeIsUp}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChangeIsDown}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Cantidad de ventas" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource KpiValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ticket promedio" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding AverageText}" Style="{StaticResource KpiValue}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ArcaText}" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>

                <!-- Timeline -->
                <Grid Margin="0,24,0,8">
                    <TextBlock Text="{Binding TimelineTitle}" FontWeight="SemiBold"/>
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Subtle}">
                        <Run Text="Máximo:"/>
                        <Run Text="{Binding TimelineMaxText, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
                <Grid Height="220">
                    <!-- guide lines: top (maximum), middle and base -->
                    <Grid Margin="0,0,0,22">
                        <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource Brush.Line}"/>
                        <Border VerticalAlignment="Center" Height="1" Background="{DynamicResource Brush.Line}"/>
                        <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Brush.LineStrong}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Timeline}" ItemTemplate="{StaticResource VerticalBar}"
                                  ItemsPanel="{StaticResource BarRow}"/>
                    <TextBlock Text="Todavía no hay ventas en este período." Style="{StaticResource EmptyHint}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Second row: products, hours and days -->
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Productos más vendidos" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Por importe, en el mismo período" Style="{StaticResource Subtle}" Margin="0,2,0,14"/>
                    <ItemsControl ItemsSource="{Binding TopProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12" ToolTip="{Binding Tooltip}" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </Grid>
                                    <Grid Height="6" Margin="0,5,0,0">
                                        <Border CornerRadius="3" Background="{DynamicResource Brush.SurfaceAlt}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Fill}"/>
                                                <ColumnDefinition Width="{Binding Rest}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Bar" CornerRadius="3" Background="{DynamicResource Brush.Primary}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPeak}" Value="True">
                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Todavía no hay productos vendidos en este período.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTopProducts}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="¿Cuándo se vende más?" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Por hora del día" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding BestHourText}" Style="{StaticResource Subtle}" Margin="0,2,0,8"/>
                    <Grid Height="130">
                        <Border VerticalAlignment="Bottom" Height="1" Margin="0,0,0,22" Background="{DynamicResource Brush.LineStrong}"/>
                        <ItemsControl ItemsSource="{Binding ByHour}" ItemTemplate="{StaticResource VerticalBar}"
                                      ItemsPanel="{StaticResource BarRow}"/>
                        <TextBlock Text="Sin ventas todavía." Style="{StaticResource EmptyHint}"/>
                    </Grid>

                    <TextBlock Text="Por día de la semana" FontWeight="SemiBold" Margin="0,22,0,0"/>
                    <TextBlock Text="{Binding BestDayText}" Style="{StaticResource Subtle}" Margin="0,2,0,8"/>
                    <Grid Height="130">
                        <Border VerticalAlignment="Bottom" Height="1" Margin="0,0,0,22" Background="{DynamicResource Brush.LineStrong}"/>
                        <ItemsControl ItemsSource="{Binding ByWeekday}" ItemTemplate="{StaticResource VerticalBar}"
                                      ItemsPanel="{StaticResource BarRow}"/>
                        <TextBlock Text="Sin ventas todavía." Style="{StaticResource EmptyHint}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
