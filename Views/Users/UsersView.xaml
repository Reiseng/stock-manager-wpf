<UserControl x:Class="StockControl.Views.Users.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StockControl.Utils"
             Background="{DynamicResource Brush.Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Usuarios" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0">
                <Run Text="{Binding Users.Count, Mode=OneWay}"/>
                <Run Text="usuarios activos"/>
            </TextBlock>
        </StackPanel>

        <!-- Search + actions -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}" Tag="Buscar usuario"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Loaded="SearchBox_Loaded"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Danger}" Tag="&#xE74D;" Content="Eliminar" ContentTemplate="{StaticResource IconText}"
                        Command="{Binding DeleteCommand}" Margin="10,0,0,0"/>
                <Button Tag="&#xE70F;" Content="Editar" ContentTemplate="{StaticResource IconText}"
                        Command="{Binding EditCommand}" Margin="10,0,0,0"/>
                <Button Style="{StaticResource Button.Primary}" Tag="&#xE710;" Content="Agregar usuario" ContentTemplate="{StaticResource IconText}"
                        Command="{Binding AddCommand}" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource GridPanel}">
            <Grid>
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Permisos" Binding="{Binding Role, Converter={StaticResource EnumDescriptionConverter}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No hay usuarios." Style="{StaticResource Subtle}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360" IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="Users.Count">
                            <Binding.Converter><x:Static Member="local:ZeroToVisibleConverter.Instance"/></Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
