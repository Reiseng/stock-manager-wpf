<UserControl x:Class="StockControl.Views.Users.AddUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="520" Margin="32,28,32,24">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="24"/>
        <TextBlock Text="Cada persona que usa el programa debería tener su propio usuario." Style="{StaticResource Subtle}" Margin="0,4,0,8"/>
        <StackPanel>
            <TextBlock Text="Nombre de usuario *" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" ToolTip="{Binding PasswordHint}"/>
        <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
        <TextBlock Text="Permisos" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding RoleTypes}" SelectedItem="{Binding SelectedRoleType}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0"
                   Text="Administrador: todo. Repositor: productos y clientes. Cajero: solo la caja."/>
        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Content="Guardar" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"
                    IsDefault="True" Margin="10,0,0,0" MinWidth="120"/>
        </StackPanel>
    </StackPanel>
</UserControl>
