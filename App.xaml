<Application x:Class="StockControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StockControl.Utils">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Colors: replaced at runtime by ThemeService (must stay first) -->
                <ResourceDictionary Source="/Themes/Palettes/Verde.xaml"/>
                <!-- Fonts and control styles -->
                <ResourceDictionary Source="/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
            <local:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
            <local:ModeToVisibilityConverter x:Key="ModeToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
