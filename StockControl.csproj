<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StockManager</AssemblyName>
    <Product>Stock Manager</Product>
    <TargetFramework>net9.0-windows</TargetFramework>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Custom Main (Program.cs): Velopack must run before WPF starts -->
    <StartupObject>StockControl.Program</StartupObject>
    <Version>1.0.0</Version>
    <Company>Reiseng Software</Company>
    <Authors>Facundo Reiseng</Authors>
  </PropertyGroup>
  
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.2" />
    <PackageReference Include="QuestPDF" Version="2025.12.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
